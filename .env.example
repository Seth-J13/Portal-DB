DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portal_db
PORT=3000

# Set DB_LOG=true to print SQL.
DB_LOG=false

# Natural-language questions. Any OpenAI-compatible chat API works.
# Groq has a free key at https://console.groq.com
# OpenAI: LLM_BASE_URL=https://api.openai.com/v1 and LLM_MODEL=gpt-4o-mini
# Ollama: LLM_BASE_URL=http://127.0.0.1:11434/v1 and LLM_MODEL=llama3.2
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
